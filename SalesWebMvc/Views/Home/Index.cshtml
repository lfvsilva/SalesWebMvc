@model SalesWebMvc.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1>Welcome back 👋</h1>
        <p>Here is an overview of your sales data.</p>
    </div>
    <a asp-controller="Sellers" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> New seller</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="stat-label">Total billed</div>
                    <div class="stat-value">@Model.TotalBilled.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon green"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="stat-label">Sales records</div>
                    <div class="stat-value">@Model.SalesCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon amber"><i class="bi bi-people"></i></div>
                <div>
                    <div class="stat-label">Sellers</div>
                    <div class="stat-value">@Model.SellerCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon pink"><i class="bi bi-building"></i></div>
                <div>
                    <div class="stat-label">Departments</div>
                    <div class="stat-value">@Model.DepartmentCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                Latest sales
                <a asp-controller="SalesRecords" asp-action="SimpleSearch" class="small fw-medium text-decoration-none">View all <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (Model.RecentSales.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-inbox"></i>No sales yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr><th>Seller</th><th>Date</th><th class="text-end">Amount</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in Model.RecentSales)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <partial name="_Avatar" model="@(sale.Seller?.Name ?? "?")" />
                                            <div>
                                                <div class="fw-medium">@sale.Seller?.Name</div>
                                                <div class="small text-body-secondary">@sale.Seller?.Department?.Name</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@sale.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end fw-medium">@sale.Amount.ToString("N2")</td>
                                    <td><partial name="_StatusBadge" model="sale.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-4">
        <div class="d-grid gap-3">
            <a asp-controller="SalesRecords" asp-action="Index" class="card link-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-card"><div class="stat-icon"><i class="bi bi-search"></i></div></div>
                    <div>
                        <div class="fw-semibold">Search sales</div>
                        <div class="small text-body-secondary">Filter by period, simple or grouped</div>
                    </div>
                </div>
            </a>
            <a asp-controller="Sellers" asp-action="Index" class="card link-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-card"><div class="stat-icon amber"><i class="bi bi-people"></i></div></div>
                    <div>
                        <div class="fw-semibold">Manage sellers</div>
                        <div class="small text-body-secondary">Create, edit and remove sellers</div>
                    </div>
                </div>
            </a>
            <a asp-controller="Departments" asp-action="Index" class="card link-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-card"><div class="stat-icon pink"><i class="bi bi-building"></i></div></div>
                    <div>
                        <div class="fw-semibold">Departments</div>
                        <div class="small text-body-secondary">Organize your teams</div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
