@model SalesWebMvc.Models.Department

@{
    ViewData["Title"] = "New department";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Departments</a>
        <h1 class="mt-1">New department</h1>
    </div>
</div>

<div class="card" style="max-width: 520px">
    <form asp-action="Create">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Electronics" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="card-footer bg-transparent d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Create</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
