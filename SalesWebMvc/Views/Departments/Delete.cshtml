@model SalesWebMvc.Models.Department

@{
    ViewData["Title"] = "Delete department";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Departments</a>
        <h1 class="mt-1">Delete department</h1>
    </div>
</div>

<div class="card" style="max-width: 520px">
    <div class="card-body">
        <div class="alert alert-danger d-flex gap-2 align-items-start">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>Are you sure you want to delete this department? This action cannot be undone.</div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="avatar"><i class="bi bi-building"></i></span>
            <div class="fs-5 fw-semibold">@Model.Name</div>
        </div>
    </div>
    <form asp-action="Delete" class="card-footer bg-transparent d-flex justify-content-end gap-2 py-3">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
    </form>
</div>
