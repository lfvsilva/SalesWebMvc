@model IEnumerable<IGrouping<Department, SalesRecord>>
@{
    ViewData["Title"] = "Grouping search";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Sales</a>
        <h1 class="mt-1">Grouping search</h1>
    </div>
</div>

<partial name="_DateFilter" />

@if (!Model.Any())
{
    <div class="card"><div class="empty-state"><i class="bi bi-inbox"></i>No sales in this period.</div></div>
}

@foreach (var departmentGroup in Model)
{
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="avatar"><i class="bi bi-building"></i></span>
                <span class="fs-6">@departmentGroup.Key.Name</span>
                <span class="badge badge-soft neutral">@departmentGroup.Count() sales</span>
            </div>
            <div>
                <span class="small text-body-secondary me-1">Total</span>
                <span class="fs-5 fw-bold">@departmentGroup.Sum(x => x.Amount).ToString("N2")</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Seller</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in departmentGroup)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Date)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <partial name="_Avatar" model="@(item.Seller?.Name ?? "?")" />
                                    <span class="fw-medium">@item.Seller?.Name</span>
                                </div>
                            </td>
                            <td class="text-end fw-medium">@Html.DisplayFor(modelItem => item.Amount)</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
