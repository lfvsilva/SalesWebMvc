@model IEnumerable<SalesWebMvc.Models.SalesRecord>

@{
    ViewData["Title"] = "Simple search";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Sales</a>
        <h1 class="mt-1">Simple search</h1>
    </div>
</div>

<partial name="_DateFilter" />

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="stat-label">Total sales</div>
                    <div class="stat-value">@Model.Sum(obj => obj.Amount).ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon green"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="stat-label">Records</div>
                    <div class="stat-value">@Model.Count()</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-inbox"></i>No sales in this period.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Html.DisplayNameFor(model => model.Date)</th>
                        <th>@Html.DisplayNameFor(model => model.Seller)</th>
                        <th>@Html.DisplayNameFor(model => model.Seller!.Department)</th>
                        <th class="text-end">@Html.DisplayNameFor(model => model.Amount)</th>
                        <th>@Html.DisplayNameFor(model => model.Status)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-body-secondary">@item.Id</td>
                            <td>@Html.DisplayFor(modelItem => item.Date)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <partial name="_Avatar" model="@(item.Seller?.Name ?? "?")" />
                                    <span class="fw-medium">@item.Seller?.Name</span>
                                </div>
                            </td>
                            <td><span class="badge badge-soft neutral">@item.Seller?.Department?.Name</span></td>
                            <td class="text-end fw-medium">@Html.DisplayFor(modelItem => item.Amount)</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
