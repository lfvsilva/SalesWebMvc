@{
    ViewData["Title"] = "Sales";
    var today = DateTime.Now.ToString("yyyy-MM-dd");
    var firstDay = new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd");
}

<div class="page-header">
    <div>
        <h1>Sales</h1>
        <p>Search sales records by period.</p>
    </div>
</div>

<div class="row g-3">
    @foreach (var (action, title, description, icon, iconClass) in new[]
    {
        ("SimpleSearch", "Simple search", "List every sale in the period with its total.", "bi-list-ul", ""),
        ("GroupingSearch", "Grouping search", "See sales grouped by department with subtotals.", "bi-diagram-3", "green")
    })
    {
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3 stat-card">
                        <div class="stat-icon @iconClass"><i class="bi @icon"></i></div>
                        <div>
                            <h2 class="h5 mb-0">@title</h2>
                            <div class="small text-body-secondary">@description</div>
                        </div>
                    </div>
                    <form asp-action="@action" method="get" class="row g-3 align-items-end">
                        <div class="col-sm">
                            <label class="form-label" for="@(action)-min">Min date</label>
                            <input type="date" id="@(action)-min" name="minDate" value="@firstDay" class="form-control" />
                        </div>
                        <div class="col-sm">
                            <label class="form-label" for="@(action)-max">Max date</label>
                            <input type="date" id="@(action)-max" name="maxDate" value="@today" class="form-control" />
                        </div>
                        <div class="col-sm-auto">
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Search</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
