<div class="card mb-4">
    <form method="get" class="card-body row g-3 align-items-end">
        <div class="col-sm-auto">
            <label for="minDate" class="form-label">Min date</label>
            <input type="date" class="form-control" id="minDate" name="minDate" value="@ViewData["minDate"]" />
        </div>
        <div class="col-sm-auto">
            <label for="maxDate" class="form-label">Max date</label>
            <input type="date" class="form-control" id="maxDate" name="maxDate" value="@ViewData["maxDate"]" />
        </div>
        <div class="col-sm-auto">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
        </div>
    </form>
</div>
