@model SalesWebMvc.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card mx-auto" style="max-width: 560px">
    <div class="card-body text-center py-5">
        <div class="stat-card d-inline-block mb-3">
            <div class="stat-icon pink mx-auto" style="width:56px;height:56px;font-size:1.6rem"><i class="bi bi-exclamation-octagon"></i></div>
        </div>
        <h1 class="h3">Something went wrong</h1>
        <p class="text-body-secondary mb-4">@(Model?.Message ?? "An error occurred while processing your request.")</p>

        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-body-secondary">Request ID: <code>@Model.RequestId</code></p>
        }

        <a href="javascript:history.back()" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left me-1"></i> Go back</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Dashboard</a>
    </div>
</div>
