@model IEnumerable<SalesWebMvc.Models.Seller>

@{
    ViewData["Title"] = "Sellers";
}

<div class="page-header">
    <div>
        <h1>Sellers</h1>
        <p>@Model.Count() sellers registered</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> New seller</a>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-people"></i>No sellers yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.BirthDate)</th>
                        <th class="text-end">@Html.DisplayNameFor(model => model.BaseSalary)</th>
                        <th>@Html.DisplayNameFor(model => model.Department)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <partial name="_Avatar" model="item.Name" />
                                    <div>
                                        <div class="fw-medium">@item.Name</div>
                                        <div class="small text-body-secondary">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@Html.DisplayFor(model => item.BirthDate)</td>
                            <td class="text-end">@Html.DisplayFor(model => item.BaseSalary)</td>
                            <td><span class="badge badge-soft neutral">@item.Department?.Name</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-icon text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
