@model SalesWebMvc.Models.Seller

@{
    ViewData["Title"] = "Delete seller";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Sellers</a>
        <h1 class="mt-1">Delete seller</h1>
    </div>
</div>

<div class="card border-danger-subtle" style="max-width: 640px">
    <div class="card-body">
        <div class="alert alert-danger d-flex gap-2 align-items-start">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>Are you sure you want to delete this seller? This action cannot be undone.</div>
        </div>
        <partial name="_SellerDetails" />
    </div>
    <form asp-action="Delete" class="card-footer bg-transparent d-flex justify-content-end gap-2 py-3">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
    </form>
</div>
