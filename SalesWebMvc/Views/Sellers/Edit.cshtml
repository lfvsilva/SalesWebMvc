@model SalesWebMvc.Models.ViewModels.SellerFormViewModel

@{
    ViewData["Title"] = "Edit seller";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Sellers</a>
        <h1 class="mt-1">Edit seller</h1>
    </div>
</div>

<div class="card" style="max-width: 760px">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Seller!.Id" />
        <div class="card-body">
            <partial name="_SellerFormFields" />
        </div>
        <div class="card-footer bg-transparent d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
