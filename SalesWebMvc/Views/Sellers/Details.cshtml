@model SalesWebMvc.Models.Seller

@{
    ViewData["Title"] = "Seller details";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Sellers</a>
        <h1 class="mt-1">Seller details</h1>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
</div>

<div class="card" style="max-width: 640px">
    <div class="card-body">
        <partial name="_SellerDetails" />
    </div>
</div>
